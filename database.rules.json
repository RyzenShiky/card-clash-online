{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "public": {
          ".read": "auth != null",
          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32"
          },
          "photoURL": {
            ".validate": "newData.isString() || newData.val() === null"
          },
          "accountType": {
            ".validate": "newData.val() === 'guest' || newData.val() === 'google'"
          }
        },
        "stats": {
          ".read": "auth != null"
        },
        "private": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "ranked": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "state": {
          ".validate": "newData.val() === 'online' || newData.val() === 'offline'"
        }
      }
    },
    "playerRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          "status": {
            ".validate": "newData.val() === 'waiting' || newData.val() === 'starting' || newData.val() === 'playing' || newData.val() === 'paused' || newData.val() === 'finished' || newData.val() === 'closed'"
          },
          "roomCode": {
            ".validate": "newData.isString() && newData.val().length === 6"
          }
        },
        "settings": {
          "maxPlayers": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 6"
          }
        },
        "players": {
          "$uid": {
            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    },
    "leaderboard": {
      "wins": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "matches": {
      "$matchId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "privateGameData": {
      "$matchId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "matchmaking": {
      "$queue": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$roomId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "ruleCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
